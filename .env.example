# Frontend environment — template only.
#
# Copy to `.env.local` for local development:
#
#   cp .env.example .env.local
#
# Vite reads `.env.local` automatically. Backend variables are NOT
# read here — the server has its own process environment. See
# server/.env.example and docs/ENVIRONMENT.md.
#
# ⚠️  Every VITE_* variable is INLINED INTO THE PUBLIC JAVASCRIPT BUNDLE
#     at build time. Anything you put here is visible to every visitor
#     who loads the page. Never place a real secret in a VITE_ variable.

# --- API --------------------------------------------------------------------
# Backend API root. Trailing slashes are trimmed at runtime.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Repository selection ---------------------------------------------------
# Must be exactly 'true' to route reads through the backend API.
# Any other value (including unset) selects the in-memory demo
# repository.
#
# NOTE: this flag is currently inert in the running app — the store
# reads seed data directly and does not call the repository yet. It
# becomes meaningful when the store moves onto the repository
# (roadmap Phase 3). Do not rely on it to switch the app.
VITE_USE_API_REPOSITORY=

# --- Demo-mode affordances -------------------------------------------------
# Must be exactly 'true' to enable demo-only controls. Default OFF.
#
# The demo role switcher lets anyone viewing the app assume the identity
# of ANY seeded user, including `super-admin`. It used to ship to every
# user behind a "Demo only" label that was not a control. It is now
# gated here.
#
#   unset / anything but 'true' → switcher does not render at all
#   'true'                      → desktop + mobile switchers render,
#                                 plus a "Demo mode" badge
#
# This is a BUILD-TIME flag. Vite inlines it into the artefact, so a
# production build with it on ships user-switching to everyone who loads
# the page. Keep demo and production as separate builds.
#
# '1', 'TRUE' and 'yes' all leave it OFF — only the exact string
# 'true' enables it.
# See src/services/demoFlags.js
VITE_ENABLE_DEMO_ROLE_SWITCHER=true

# --- Dev auth token (DEVELOPMENT ONLY) --------------------------------------
# ⚠️  MUST BE UNSET IN EVERY PRODUCTION BUILD.
#     Vite inlines this into the public bundle, so a production build
#     with this set ships a working bearer token to every visitor.
#
# Only for local development against a backend running with
# DEV_AUTH_ENABLED=true. Valid values are the dev role keys documented
# in server/README.md (dev-super, dev-field, dev-admin, ...).
VITE_DEV_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# PRODUCTION CHECKLIST — see docs/ENVIRONMENT.md
#
#   [ ] NODE_ENV=production            (backend)
#   [ ] DEV_AUTH_ENABLED=false         (backend — MUST be false)
#   [ ] DEV_AUTH_OFFLINE_FALLBACK=false (backend — MUST be false)
#   [ ] JWT_SECRET set                 (backend)
#   [ ] DATABASE_URL includes sslmode=verify-full
#   [ ] DB_SSL_MODE=verify-full        (backend)
#   [ ] DB_SSL_REJECT_UNAUTHORIZED is not 'false'
#   [ ] CORS_ORIGINS is an explicit origin, never '*'
#   [ ] VITE_DEV_AUTH_TOKEN unset      (frontend — MUST be empty)
#   [ ] VITE_ENABLE_DEMO_ROLE_SWITCHER unset (frontend — MUST be empty)
# ---------------------------------------------------------------------------
