# Test-suite environment. Loaded via `node --env-file=.env.test` by
# `npm test` (Node 20.6+). Tracked in git on purpose — every value here
# is a throwaway constant, never a real secret.
#
# Why this file exists: the token service refuses to sign or verify
# without a usable key. Tests that exercise the real signing path need
# one, and hardcoding it per test file would mean a dozen copies to keep
# in sync. This is the single place.
#
# This key is NOT valid for any deployed environment. Production boots
# refuse a short or placeholder key (see assertJwtSecretStrength), and
# `NODE_ENV=production` never reaches this file.

JWT_SECRET=test-only-secret-not-used-in-production-0000
JWT_ISSUER=estateflow-api
JWT_AUDIENCE=estateflow-clients
