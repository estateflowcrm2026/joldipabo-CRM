# Backend environment — template only. Never commit real secrets.
#
# ⚠️  NOTHING LOADS THIS FILE AUTOMATICALLY. There is no `dotenv`
#     dependency and the npm scripts do not pass `--env-file`. The
#     server reads `process.env` only, so copying this file to `.env`
#     and running `npm start` will SILENTLY IGNORE IT.
#
# Use one of:
#
#   node --env-file=.env src/server.js      # explicit single run
#   export $(grep -v '^#' .env | xargs)     # current shell
#   # or the platform's environment injection (preferred in production)
#
# Full variable matrix per environment: docs/ENVIRONMENT.md

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- Runtime mode -----------------------------------------------------------
# `production` enables the boot-time safety guards in
# src/config/index.js. Development and staging are unaffected.
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Postgres connection string. The default points at the docker-compose
# service in server/docker-compose.yml (db: estateflow_dev, role: estateflow).
#
# ⚠️  Managed providers (RDS, Cloud SQL, Neon, Supabase) REFUSE cleartext
#     connections. For production append `?sslmode=verify-full` and set
#     DB_SSL_MODE=verify-full below.
# DATABASE_URL=postgres://estateflow:estateflow@127.0.0.1:5432/estateflow_dev
#
# --- Application runtime role -----------------------------------------
# `DATABASE_URL` is the MIGRATION role: it owns the tables and is used by
# db:migrate, db:seed, db:reset and the admin scripts.
#
# `APP_DATABASE_URL` is what the RUNNING SERVER connects as. It should be a
# non-owner, NOBYPASSRLS role, because a role that owns the tables is
# exempt from row-level security — the policies would be installed,
# correct, and enforcing nothing.
#
# Optional: when unset the server falls back to DATABASE_URL, so existing
# development setups need no change. Production REFUSES to boot without
# it. See docs/RLS_ROLLOUT_PLAN.md §1.
#
#   npm run db:app-role -- --create
#   npm run db:app-role -- --rotate-password --write-env
#
# APP_DATABASE_URL=postgres://estateflow_app:PASSWORD@127.0.0.1:5432/estateflow_dev

# --- Postgres TLS -----------------------------------------------------------
# auto        — infer from DATABASE_URL's sslmode. The default. A local
#               Docker URL has no sslmode, so this resolves to `disable`
#               and existing local setups keep working unchanged.
# disable     — no TLS. Loopback only.
# require     — encrypted, certificate NOT verified. Staging on a trusted
#               network, or a self-signed cert you accept the risk on.
#               🛑 REFUSED AT BOOT when NODE_ENV=production.
# verify-full — encrypted with full chain + hostname verification.
#               THE PRODUCTION SETTING.
DB_SSL_MODE=auto

# Escape hatch for a self-signed staging certificate.
# 🛑 REFUSED AT BOOT when NODE_ENV=production — point DB_SSL_CA_FILE at
#    the certificate bundle instead of disabling verification.
DB_SSL_REJECT_UNAUTHORIZED=true

# Private CA bundle, for providers whose certificate is not in the
# system trust store. DB_SSL_CA_FILE (path) is preferred over the
# inline DB_SSL_CA (PEM string).
#
# SUPABASE (production) REQUIRES THIS. Supabase's root is in no system
# trust store, so verify-full fails with "self-signed certificate in
# certificate chain" without it, and production must use the DIRECT host
# (db.<project-ref>.supabase.co) — the pooler cannot reach verify-full.
# Obtain the root with a fingerprint-pinned fetch:
#
#   npm run db:fetch-ca -- --host db.<project-ref>.supabase.co
#   → server/certs/supabase-root-2021.pem
#
# ...then:
#   DB_SSL_MODE=verify-full
#   DB_SSL_CA_FILE=/absolute/path/to/supabase-root-2021.pem
#
# The path is resolved where the PROCESS runs — inside the container,
# not on the host. Confirm before deploying:
#
#   npm run db:ssl-check --connect
#
# See docs/SUPABASE_VERIFICATION.md §5.
# DB_SSL_CA_FILE=/etc/ssl/certs/estateflow-ca.pem
# DB_SSL_CA=-----BEGIN CERTIFICATE-----

# --- Connection resilience --------------------------------------------------
# Per-statement timeout. Without it a runaway query pins a pool slot
# until the connection dies; with max: 10, ten of them exhaust the pool
# and every later request fails on connectionTimeoutMillis.
DB_STATEMENT_TIMEOUT_MS=30000
# Lock acquisition timeout — stops a migration deadlocking against live traffic.
DB_LOCK_TIMEOUT_MS=10000
DB_POOL_MAX=10

# --- JWT / sessions ---------------------------------------------------------
# Placeholder. Required before any real authentication wiring lands.
# ⚠️  REQUIRED in production. src/server.js REFUSES TO BOOT when
#     NODE_ENV=production and this is unset. Generate with:
#       node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=replace-me-with-a-real-secret-from-kms
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=30

# --- CORS -------------------------------------------------------------------
# Comma-separated. The defaults cover the local Vite dev servers.
# ⚠️  `CORS_ORIGINS=*` DISABLES CORS rather than opening it — the origin
#     check is an exact-match `Array.includes`, so no real browser origin
#     will match. Always enumerate origins explicitly.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5180

# --- Dev auth shortcut ------------------------------------------------------
# When DEV_AUTH_ENABLED=true, the server accepts short tokens of the form
# `Authorization: Bearer dev-<role>` and resolves them to a seeded user.
# Mapped in server/src/repositories/authRepository.js (DEV_KEY_TO_USER_ID).
#
# 🛑 PRODUCTION MUST LEAVE THIS OFF. src/server.js refuses to boot when
#    NODE_ENV=production and DEV_AUTH_ENABLED=true (see
#    assertProductionSafety in src/config/index.js). The valid role keys
#    are documented in README.md, so this flag left on is a public
#    super-admin endpoint.
#
# DEV_AUTH_OFFLINE_FALLBACK now defaults to false (it was true until
# 2026-09-24). Setting only DEV_AUTH_ENABLED=true used to grant full
# in-code permission matrices with no database row behind them.
# Opt in explicitly if you want offline dev auth.
#
# DEV_AUTH_ENABLED=false|true
# DEV_AUTH_OFFLINE_FALLBACK=false|true
# DEV_AUTH_TENANT_ID=org_acme
# Valid dev keys: dev-admin, dev-super, dev-sales, dev-site, dev-field,
#                 dev-field2, dev-tele, dev-cpm, dev-accounts.
DEV_AUTH_ENABLED=false
DEV_AUTH_OFFLINE_FALLBACK=false
DEV_AUTH_TENANT_ID=org_acme
